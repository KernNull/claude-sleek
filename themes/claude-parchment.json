  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9a9386",
        "fontStyle": "italic"
      },
      "name": "Comments"
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.block.javadoc"
      ],
      "settings": {
        "foreground": "#9a9386",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#bf5232",
        "fontStyle": ""
      },
      "name": "Keywords"
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic"
      ],
      "settings": {
        "foreground": "#6f685d",
        "fontStyle": ""
      },
      "name": "Operators"
    },
    {
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#bf5232",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "storage.type.function",
        "storage.type.class",
        "storage.type.js"
      ],
      "settings": {
        "foreground": "#bf5232",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#4a7a2e",
        "fontStyle": ""
      },
      "name": "Strings"
    },
    {
      "scope": [
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#4a7a2e",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#127f72",
        "fontStyle": ""
