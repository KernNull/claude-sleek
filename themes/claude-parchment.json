        "constant.language",
        "constant.character",
        "support.constant"
      ],
      "settings": {
        "foreground": "#7d47b0",
        "fontStyle": ""
      },
      "name": "Numbers & constants"
    },
    {
      "scope": [
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#a87000",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
