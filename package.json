        "uiTheme": "vs-dark",
        "path": "./themes/claude-ember-black-no-italics.json"
      },
      {
        "label": "Claude Parchment (No Italics)",
        "uiTheme": "vs",
        "path": "./themes/claude-parchment-no-italics.json"
